{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": false,
		"types": [
			"node"
		]
	},
	"include": [
		"packages/*/src/**/*.ts"
	],
	"exclude": [
		"**/*.test.ts"
	]
}
